{
  "name": "dsh-feishu-oauth",
  "version": "0.1.1",
  "description": "Feishu OAuth login for DeepSeek Harness using native session cookies",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/lloydzhou/dsh-feishu-oauth.git" },
  "homepage": "https://github.com/lloydzhou/dsh-feishu-oauth#readme",
  "bugs": { "url": "https://github.com/lloydzhou/dsh-feishu-oauth/issues" },
  "keywords": ["dsh", "deepseek-harness", "feishu", "oauth", "plugin"],
  "type": "module",
  "main": "./index.js",
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./package.json": "./package.json" },
  "files": ["index.js", "oauth.js", "oauth-locale.js", "login-page.js", "settings.js", "client.js", "locale", "cordis.patch.yml", "README.md", "LICENSE", "SECURITY.md", "SETTINGS-INTEGRATION.md", "ASSET-ATTRIBUTION.md"],
  "engines": { "node": ">=24.9.0", "dsh": ">=0.2.1-rc.3" },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check oauth.js && node --check oauth-locale.js && node --check login-page.js && node --check settings.js && node --check client.js && node --check client-source.js && node --check settings-form.js && node --check build-client.mjs",
    "build:client": "node build-client.mjs",
    "prepack": "npm run build:client && npm run check && npm test"
  },
  "devDependencies": { "esbuild": "0.28.2" },
  "peerDependencies": { "@deepseek-ai/cordis": "^4.0.5", "@deepseek-ai/schemastery": "^3.18.5" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-plugin-manager"],
      "platform": "web"
    }
  }
}
